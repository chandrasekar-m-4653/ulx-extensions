{
  "name": "ulx-extension-builder",
  "version": "1.0.0",
  "private": true,
  "description": "Backstage starter for a space-settings welcome widget built with PrimeReact and Tailwind",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "node scripts/build-extension.mjs",
    "validate": "node scripts/validate-extension.mjs",
    "check": "npm run validate && npm run build",
    "test:workflow": "node --test scripts/zet-workflow.test.mjs",
    "preview": "vite preview",
    "pack": "node scripts/zet-workflow.mjs pack",
    "zet": "node scripts/zet-workflow.mjs",
    "zet:init": "node scripts/zet-workflow.mjs init",
    "zet:run": "node scripts/zet-workflow.mjs run",
    "zet:validate": "node scripts/zet-workflow.mjs validate",
    "zet:pack": "node scripts/zet-workflow.mjs pack",
    "sigma:login": "node scripts/zet-workflow.mjs login",
    "sigma:whoami": "node scripts/zet-workflow.mjs whoami",
    "sigma:workspaces": "node scripts/zet-workflow.mjs workspaces",
    "sigma:push": "node scripts/zet-workflow.mjs push",
    "sigma:pull": "node scripts/zet-workflow.mjs pull",
    "sigma:cloud:run": "node scripts/zet-workflow.mjs cloud-run",
    "sigma:cloud:stop": "node scripts/zet-workflow.mjs cloud-stop",
    "sigma:logout": "node scripts/zet-workflow.mjs logout"
  },
  "dependencies": {
    "primeicons": "^7.0.0",
    "primereact": "^10.9.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.3",
    "@zohosigma/zoho-extension-toolkit": "^1.5.44"
  },
  "engines": {
    "node": ">=18"
  }
}
